<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book Inventory</title>
</head>
<body>
  <h1>Book Categories</h1>
  <% if(categories.length > 0) { %>
    <ul>
      <% categories.forEach(c => { %>
        <li>
          <div>
            <a href="/categories/<%= c.name.toLowerCase() %>"><%= c.name %></a>
            <form action="/<%= c.name.toLowerCase() %>/delete" onsubmit="confirm('Are you sure you want to delete this catergory?')">
              <button type="submit">Delete</button>
            </form>
            <form action="/<%= c.name.toLowerCase() %>/update">
              <button type="submit">Update</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No Category Found!</p>
  <% } %>
</body>
</html>