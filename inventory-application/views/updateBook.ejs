<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit <%= title %> | Shelf</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">Shelf</a>
        <nav class="header-nav" aria-label="Primary navigation">
          <a href="/">Categories</a>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <a class="breadcrumb" href="/categories/<%= category %>"
        >&larr; Back to <%= category %></a
      >
      <section aria-labelledby="page-title">
        <p class="eyebrow">Book settings</p>
        <h1 id="page-title">Edit book</h1>
        <div class="form-panel">
          <form
            action="/categories/<%= category %>/<%= title %>/update"
            method="POST"
          >
            <div class="field">
              <label for="title">Book title</label>
              <input
                type="text"
                minlength="2"
                maxlength="150"
                name="title"
                id="title"
                value="<%= title %>"
                required
              />
            </div>
            <div class="form-actions">
              <button class="button" type="submit">Save changes</button>
              <a class="text-link" href="/categories/<%= category %>">Cancel</a>
            </div>
          </form>
        </div>
      </section>
    </main>
  </body>
</html>
