<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <a href="/">Back to home</a>
    
    <% if(result.length > 0) {%>
      <ul>
      <% result.forEach(username => { %>
        <li><%= username.username %></li>
      <% }) %>
      </ul>
    <% } else { %>
      <p>No user found!</p>
    <% } %>

    
  </body>
</html>