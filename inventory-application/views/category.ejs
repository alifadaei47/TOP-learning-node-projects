<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>

<body>
  <h1>Books</h1>

  <div>
    <p>Add a new book</p>
    <form action="/categories/<%= category %>/add-book" method="POST">
      <label for="book">Book's name: </label>
      <input type="text" min="2" max="150" name="book" id="book">
      <button type="submit">Add</button>
    </form>
  </div>

  <% if(items.length > 0) { %>
  <% items.forEach(item=> { %>
  <div>
    <p><%= item.title %></p>
    
    <form action="/categories/<%= category %>/<%= item.title %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this book?')">
      <button type="submit">Delete</button>
    </form>

    <form action="/categories/<%= category %>/<%= item.title %>/update">
      <button type="submit">Update</button>
    </form>
  </div>
  <% }) %>
  <% } else {%>
  <p>There is no book in this category yet!</p>
  <% } %>
</body>

</html>