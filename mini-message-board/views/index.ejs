<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="page-shell">
    <% if(messages.length) { %>
      <header class="page-header">
        <div>
          <p class="eyebrow">Message board</p>
          <h1>Messages</h1>
        </div>
        <a class="button" href="/new">New message</a>
      </header>
      <ul class="message-list">
        <% messages.forEach(message => { %>
          <li class="message">
            <div class="message-meta">
              <strong><%= message.user %></strong>
              <time><%= message.added %></time>
            </div>
            <p><%= message.text %></p>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="empty-state">
        <p class="eyebrow">Message board</p>
        <h1>There are no messages yet.</h1>
        <a class="button" href="/new">Write the first one</a>
      </div>
    <% } %>
  </main>
</body>
</html>