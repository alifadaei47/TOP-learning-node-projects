<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main>
    <header>
      <h1><%= title %></h1>
      <span class="mono">USER DIRECTORY / 01</span>
    </header>
    <form class="search-form" action="/search" method="GET">
    <h2>Search users</h2>
    <% if (errors !== undefined) { %>
      <%- include("partials/errors.ejs") %>
    <% } %>
    <div class="field">
      <label for="name">Name</label>
      <input type="text" name="name" id="name">
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input type="email" name="email" id="email">
    </div>

    <button type="submit">Search</button>
    </form>
  <ul class="user-list">
    <% if (locals.users) { %>
      <% users.forEach(user => { %>
        <li class="user-item">
          <div class="user-details">
            <span class="user-name"><%= user.firstName %> <%= user.lastName %></span>
            <span class="user-meta"><%= user.email %> / ID <%= user.id %> / AGE <%= user.age || "--" %></span>
            <% if (user.bio) { %><p class="user-bio"><%= user.bio %></p><% } %>
          </div>
          <div class="actions">
            <a class="button subtle" href="/<%= user.id %>/update">Update</a>
            <form class="inline-form" action="/<%= user.id %>/delete" method="POST">
              <button type="submit" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
            </form>
          </div>
        </li>
      <% }); %>
    <% } %>
  </ul>
  <div class="page-actions">
    <a class="button" href="/create">Create a user</a>
  </div>
  </main>
</body>
</html>
