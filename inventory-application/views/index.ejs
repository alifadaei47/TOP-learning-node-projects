<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book Inventory</title>
</head>
<body>
  <h1>Book Categories</h1>
  <% if(categories.length > 0) { %>
    <ul>
      <% categories.forEach(c => { %>
        <li><a href="/category?name"></a></li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>